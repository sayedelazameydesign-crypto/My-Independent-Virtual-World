{
  "name": "@mivw/kernel-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, local-only MIVW kernel prototype",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "biome lint --error-on-warnings src test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
